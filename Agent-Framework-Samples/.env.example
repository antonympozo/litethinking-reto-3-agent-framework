# Variables para Casos 1, 2 y 3 (GitHub Models / OpenAI-compatible Endpoint - DeepSeek V3)
GITHUB_TOKEN=<tu-token-o-deepseek-api-key>
GITHUB_ENDPOINT=https://api.deepseek.com/v1
GITHUB_MODEL_ID=deepseek-chat

# Variables para Caso 4 (Proyecto AI / Modelo Desplegado)
FOUNDRY_PROJECT_ENDPOINT=https://api.deepseek.com/v1
FOUNDRY_MODEL=deepseek-chat
FOUNDRY_API_KEY=<tu-token-o-deepseek-api-key>
